{
  "comment": "Test vectors of the module schema subset (ADR 0039), read by the agent (src/schema/tests.rs) and the server (server/internal/domain/module): both checkers must agree. A schema case changes the base schema at a JSON pointer (value, or remove) and names a part of the error; a config case validates config (JSON text) with the names of the secrets given (none if absent), required replacing the schema's, and names a part of the error or the result with the defaults.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "test",
    "type": "object",
    "additionalProperties": false,
    "required": ["url"],
    "properties": {
      "url": { "type": "string", "format": "uri", "maxLength": 512, "default": "http://127.0.0.1/stub_status" },
      "timeout": { "type": "string", "format": "duration", "maxLength": 8, "default": "5s" },
      "addr": { "type": "string", "format": "host-port", "maxLength": 64 },
      "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
      "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
      "verify": { "type": "boolean", "default": true },
      "mode": { "type": "string", "enum": ["plain", "tls"], "maxLength": 8 },
      "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "maxLength": 63, "minLength": 2 },
      "password": { "type": "string", "writeOnly": true, "maxLength": 256 },
      "paths": { "type": "array", "maxItems": 4, "items": { "type": "string", "format": "path", "maxLength": 256 } },
      "codes": { "type": "array", "maxItems": 3, "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
    }
  },
  "schema_cases": [
    { "pointer": "/additionalProperties", "value": true, "error": "additionalProperties" },
    { "pointer": "/additionalProperties", "remove": true, "error": "additionalProperties" },
    { "pointer": "/type", "value": "array", "error": "type object" },
    { "pointer": "/oneOf", "value": [], "error": "not in the subset" },
    { "pointer": "/properties", "remove": true, "error": "no properties" },
    { "pointer": "/properties/url/maxLength", "remove": true, "error": "maxLength" },
    { "pointer": "/properties/url/maxLength", "value": 5000, "error": "maxLength of 1 to 4096" },
    { "pointer": "/properties/url/maxLength", "value": 1.5, "error": "maxLength is no count" },
    { "pointer": "/properties/user/minLength", "value": 64, "error": "minLength above maxLength" },
    { "pointer": "/properties/port/minimum", "remove": true, "error": "minimum" },
    { "pointer": "/properties/port/minimum", "value": 70000, "error": "minimum above maximum" },
    { "pointer": "/properties/port/maximum", "value": 1.5, "error": "an integer needs maximum" },
    { "pointer": "/properties/ratio/maximum", "remove": true, "error": "a number needs maximum" },
    { "pointer": "/properties/paths/maxItems", "remove": true, "error": "maxItems" },
    { "pointer": "/properties/paths/maxItems", "value": 300, "error": "maxItems of 1 to 256" },
    { "pointer": "/properties/paths/items/type", "value": "boolean", "error": "items are strings or integers" },
    { "pointer": "/properties/paths/items/title", "value": "x", "error": "items: title is not in the subset" },
    { "pointer": "/properties/codes/items/minimum", "remove": true, "error": "an integer needs minimum" },
    { "pointer": "/properties/user/pattern", "value": "[a-z]+", "error": "anchored" },
    { "pointer": "/properties/user/pattern", "value": "^(a$", "error": "pattern" },
    { "pointer": "/properties/mode/enum", "value": [1, 2], "error": "enum holds strings" },
    { "pointer": "/properties/mode/enum", "value": [], "error": "enum is a list of strings" },
    { "pointer": "/properties/url/format", "value": "email", "error": "format email is not in the subset" },
    { "pointer": "/properties/password/default", "value": "x", "error": "a credential has no default" },
    { "pointer": "/properties/password/writeOnly", "value": "yes", "error": "writeOnly is no boolean" },
    { "pointer": "/properties/timeout/default", "value": "2h", "error": "timeout: default: at most an hour" },
    { "pointer": "/properties/port/default", "value": 0, "error": "port: default: 0 is not within 1 to 65535" },
    { "pointer": "/required", "value": ["nope"], "error": "required names an unknown property" },
    { "pointer": "/required", "value": "url", "error": "required is no list" },
    { "pointer": "/properties/verify/oneOf", "value": [], "error": "a boolean: oneOf is not in the subset" },
    { "pointer": "/properties/Port", "value": { "type": "integer", "minimum": 1, "maximum": 2 }, "error": "Port: not a property name" },
    { "pointer": "/properties/port/writeOnly", "value": true, "error": "only a string can be a credential" },
    { "pointer": "/properties/port/type", "value": "object", "error": "type is string, integer, number, boolean or array" },
    { "pointer": "/properties/port", "value": 1, "error": "port: no object" },
    { "pointer": "/title", "value": "still fine" }
  ],
  "config_cases": [
    {
      "config": "{\"url\":\"http://127.0.0.1:8080/status\"}",
      "result": { "url": "http://127.0.0.1:8080/status", "timeout": "5s", "verify": true }
    },
    {
      "config": "{\"url\":\"https://[::1]/x\",\"addr\":\"[::1]:6379\",\"port\":443,\"ratio\":0.5,\"verify\":false,\"mode\":\"tls\",\"user\":\"pg_monitor\",\"paths\":[\"/etc/ssl/a.pem\"],\"codes\":[200,301],\"timeout\":\"500ms\"}",
      "result": { "url": "https://[::1]/x", "addr": "[::1]:6379", "port": 443, "ratio": 0.5, "verify": false, "mode": "tls", "user": "pg_monitor", "paths": ["/etc/ssl/a.pem"], "codes": [200, 301], "timeout": "500ms" }
    },
    { "config": "", "error": "url: required" },
    { "config": "  ", "error": "url: required" },
    { "config": "{\"url\":\"ftp://x/\"}", "error": "url: an http or https URL" },
    { "config": "{\"url\":\"http://alice@127.0.0.1/\"}", "error": "without user and password" },
    { "config": "{\"url\":\"http:///x\"}", "error": "url: not a URL" },
    { "config": "{\"url\":\"http://x/a b\"}", "error": "url: not a URL" },
    { "config": "{\"url\":\"http://x/\",\"extra\":1}", "error": "extra: unknown property" },
    { "config": "{\"url\":\"http://x/\",\"port\":0}", "error": "port: 0 is not within 1 to 65535" },
    { "config": "{\"url\":\"http://x/\",\"port\":\"80\"}", "error": "port: not an integer" },
    { "config": "{\"url\":\"http://x/\",\"port\":80.5}", "error": "port: not an integer" },
    { "config": "{\"url\":\"http://x/\",\"ratio\":1.5}", "error": "ratio: 1.5 is not within 0 to 1" },
    { "config": "{\"url\":\"http://x/\",\"ratio\":\"1\"}", "error": "ratio: not a number" },
    { "config": "{\"url\":\"http://x/\",\"verify\":1}", "error": "verify: not a boolean" },
    { "config": "{\"url\":\"http://x/\",\"mode\":\"udp\"}", "error": "mode: \"udp\" is not one of plain, tls" },
    { "config": "{\"url\":\"http://x/\",\"user\":\"Root\"}", "error": "user: doesn't match the pattern" },
    { "config": "{\"url\":\"http://x/\",\"user\":\"a\"}", "error": "user: length 1 is not within 2 to 63" },
    { "config": "{\"url\":\"http://x/\",\"user\":\"ab\\u0007\"}", "error": "user: contains control characters" },
    { "config": "{\"url\":\"http://x/\",\"user\":7}", "error": "user: not a string" },
    { "config": "{\"url\":\"http://x/\",\"password\":\"pw\"}", "error": "password: a credential doesn't belong in the configuration" },
    { "config": "{\"url\":\"http://x/\",\"paths\":[\"/etc/../shadow\"]}", "error": "paths: item 1: an absolute path without .. segments" },
    { "config": "{\"url\":\"http://x/\",\"paths\":[\"etc/ssl\"]}", "error": "paths: item 1: an absolute path" },
    { "config": "{\"url\":\"http://x/\",\"paths\":[\"/a\",\"/b\",\"/c\",\"/d\",\"/e\"]}", "error": "paths: more than 4 items" },
    { "config": "{\"url\":\"http://x/\",\"paths\":\"/a\"}", "error": "paths: not a list" },
    { "config": "{\"url\":\"http://x/\",\"paths\":[1]}", "error": "paths: not a string" },
    { "config": "{\"url\":\"http://x/\",\"codes\":[200,700]}", "error": "codes: item 2: 700 is not within 100 to 599" },
    { "config": "{\"url\":\"http://x/\",\"codes\":[200,201,202,203]}", "error": "codes: more than 3 items" },
    { "config": "{\"url\":\"http://x/\",\"timeout\":\"90m\"}", "error": "timeout: at most an hour" },
    { "config": "{\"url\":\"http://x/\",\"timeout\":\"5\"}", "error": "timeout: a number and a unit" },
    { "config": "{\"url\":\"http://x/\",\"timeout\":\"1d\"}", "error": "timeout: the unit is ms, s, m or h" },
    { "config": "{\"url\":\"http://x/\",\"addr\":\"127.0.0.1\"}", "error": "addr: not host:port" },
    { "config": "{\"url\":\"http://x/\",\"addr\":\"x:0\"}", "error": "addr: the port is 1 to 65535" },
    { "config": "{\"url\":\"http://x/\",\"addr\":\"x:65536\"}", "error": "addr: the port is 1 to 65535" },
    { "config": "{\"url\":\"http://x/\",\"addr\":\":80\"}", "error": "addr: not a host" },
    { "config": "{\"url\":\"http://x/\",\"addr\":\"a b:80\"}", "error": "addr: not a host" },
    { "config": "{\"url\":\"http://x/\",\"addr\":\"[::1]6379\"}", "error": "addr: not [address]:port" },
    { "config": "[1]", "error": "the configuration is no object" },
    { "config": "{\"url\":", "error": "not JSON" },
    { "config": "{\"url\":\"http://x/\"}", "required": ["url", "password"], "error": "password: required" },
    { "config": "{\"url\":\"http://x/\"}", "required": ["url", "password"], "secrets": ["password"], "result": { "url": "http://x/", "timeout": "5s", "verify": true } }
  ]
}
