# Settings of the production compose (copy to .env; guide: docs/admin/installation.md).
# Secrets don't belong here: ./secrets.sh writes them to ./secrets/.

# The server image of a release, by digest: ./use-release.sh VERSION checks its signature and sets
# it (docs/admin/installation.md). Empty: compose refuses to start.
SERMON_IMAGE_DIGEST=

# DNS name of the server: web UI (https://<domain>) and agent port (<domain>:8443).
SERMON_DOMAIN=sermon.example.org
# Contact for Let's Encrypt (expiry warnings).
SERMON_ACME_EMAIL=admin@example.org

# Mail server, required (invitations go out by mail only). STARTTLS on 587 or TLS on 465
# (SERMON_SMTP_TLS=tls). With a user name the password goes to ./secrets/smtp_password.
SERMON_SMTP_HOST=smtp.example.org
SERMON_SMTP_PORT=587
SERMON_SMTP_FROM=SerMon <sermon@example.org>
SERMON_SMTP_USERNAME=

# Superadmins get a warning from 80 % of this size on (e.g. 150GiB; empty: no check, ADR 0027).
SERMON_DATABASE_SIZE_LIMIT=

# Grace period between "schedule deletion" and the deletion of an organization (ADR 0029;
# at least 168h = 7 days).
SERMON_ORG_DELETION_GRACE=720h

# Accounts without a membership are deleted after this grace (V1-17; at least 24h; never
# superadmins); the audit logs keep entries this long (2160h to 87600h).
SERMON_ACCOUNT_DELETION_GRACE=720h
SERMON_AUDIT_RETENTION=17520h
# Security events and alert history of organizations without a period of their own (V1-22):
# whole days, 168h to 8760h.
SERMON_EVENT_RETENTION=2160h

# Only for a build from source (source.yaml): the public release key compiled into the server
# (scripts/release-sign.sh pubkey) for the signed binaries in ./downloads. The published image
# has the release key and its binaries built in.
SERMON_RELEASE_KEY=

# Countries of addresses in the security dashboard (optional, nothing is downloaded): put a
# MaxMind DB file into ./geoip, e.g. DB-IP "IP to Country Lite" (CC BY 4.0) or GeoLite2 Country,
# and name it here as /srv/geoip/<file>. The attribution its licence asks for is derived from the
# file; SERMON_GEOIP_ATTRIBUTION replaces it.
SERMON_GEOIP_DB_FILE=
SERMON_GEOIP_ATTRIBUTION=

# Sign-in over an OpenID Connect provider (optional, M3-20): issuer and client; the secret goes to
# secrets/oidc_client_secret. The provider returns to https://<SERMON_DOMAIN>/auth/oidc/callback.
# SERMON_OIDC_MFA: amr (the ID token's amr names a second factor), trusted (the provider enforces
# one) or never (SerMon's own second factor applies).
SERMON_OIDC_ISSUER=
SERMON_OIDC_CLIENT_ID=
SERMON_OIDC_NAME=
SERMON_OIDC_SCOPES=
SERMON_OIDC_MFA=
# Accounts and memberships by the organizations' group mappings (scope "groups" needed): on by
# default, false turns it off (the mappings still give and take roles of existing members).
SERMON_OIDC_JIT=

# Internal destinations notification channels may reach (CIDRs, ADR 0024); empty: public only.
SERMON_OUTBOUND_ALLOWLIST=

# Memory of Loki (M3-27): the container's limit and the Go runtime's soft limit below it (about
# 90 %). 1 GiB serves a few hundred nodes; raise both together for more.
# SERMON_LOKI_MEMORY=1g
# SERMON_LOKI_GOMEMLIMIT=900MiB

# Only if the defaults collide with your networks:
# SERMON_AGENT_PORT=8443
# SERMON_EDGE_SUBNET=172.30.78.0/24
# SERMON_EDGE_IP_RANGE=172.30.78.128/25   dynamic addresses; Caddy's must lie outside
# SERMON_PROXY_IP=172.30.78.10
