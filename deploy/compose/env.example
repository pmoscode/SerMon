# Settings of the production compose (copy to .env; guide: docs/admin/installation.md).
# Secrets don't belong here: ./secrets.sh writes them to ./secrets/.

# DNS name of the server: web UI (https://<domain>) and agent port (<domain>:8443).
SERMON_DOMAIN=sermon.example.org
# Contact for Let's Encrypt (expiry warnings).
SERMON_ACME_EMAIL=admin@example.org

# Mail server, required (invitations go out by mail only). STARTTLS on 587 or TLS on 465
# (SERMON_SMTP_TLS=tls). With a user name the password goes to ./secrets/smtp_password.
SERMON_SMTP_HOST=smtp.example.org
SERMON_SMTP_PORT=587
SERMON_SMTP_FROM=SerMon <sermon@example.org>
SERMON_SMTP_USERNAME=

# Superadmins get a warning from 80 % of this size on (e.g. 150GiB; empty: no check, ADR 0027).
SERMON_DATABASE_SIZE_LIMIT=

# Public release key for agent downloads from the server (scripts/release-sign.sh pubkey); the
# signed binaries go to ./downloads. Empty: agents are installed from packages instead.
SERMON_RELEASE_KEY=

# Internal destinations notification channels may reach (CIDRs, ADR 0024); empty: public only.
SERMON_OUTBOUND_ALLOWLIST=

# Only if the defaults collide with your networks:
# SERMON_AGENT_PORT=8443
# SERMON_EDGE_SUBNET=172.30.78.0/24
# SERMON_EDGE_IP_RANGE=172.30.78.128/25   dynamic addresses; Caddy's must lie outside
# SERMON_PROXY_IP=172.30.78.10
