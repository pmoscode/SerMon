# TLS in front of the web port with Caddy's own CA (`tls internal`), as for a self-hosted server
# without a public certificate. Replaces deploy/compose/Caddyfile (ACME) in the E2E overlay; the
# agent port is not proxied there either (ADR 0028).
{
	admin off
	local_certs
	skip_install_trust
}

sermon.test, localhost {
	tls internal
	reverse_proxy server:8080
}
