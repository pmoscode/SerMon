# Settings of the E2E run for the production compose (scripts/e2e-demo.sh sets COMPOSE_ENV_FILES,
# so a local deploy/compose/.env is never read). SERMON_RELEASE_KEY comes from the environment.
SERMON_DOMAIN=sermon.test
SERMON_ACME_EMAIL=e2e@sermon.test
SERMON_SMTP_HOST=mailpit
SERMON_SMTP_PORT=1025
SERMON_SMTP_FROM=SerMon E2E <sermon@sermon.test>
SERMON_SMTP_USERNAME=sermon
SERMON_VERSION=e2e
# Sign-in over Dex (M3-22, service dex of the overlay); the client secret is written by the script.
SERMON_OIDC_ISSUER=https://dex.test:18556/dex
SERMON_OIDC_CLIENT_ID=sermon
SERMON_OIDC_NAME=Dex
SERMON_OIDC_SCOPES=email profile groups
