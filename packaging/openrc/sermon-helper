#!/sbin/openrc-run
# SerMon root helper under OpenRC (ADR 0035): runs as root and binds /run/sermon/helper.sock
# itself (root:sermon 0660). A run is a process group of its own and outlives a restart.
# The variables are read by openrc-run.
# shellcheck shell=sh disable=SC2034

name="SerMon root helper"
description="Runs package updates and reboots for the SerMon agent"
command="/usr/local/bin/sermon-helper"
command_args="serve"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
# To syslog, which rotates (busybox syslogd): a looping agent can't fill /var/log (review M4-04).
error_logger="logger -t sermon-helper -p daemon.info"

depend() {
	need localmount
	after net
}

start_pre() {
	checkpath --directory --mode 0700 --owner root:root /var/lib/sermon-helper
}

# The helper binds the socket itself and is ended by a signal: its file stays otherwise.
stop_post() {
	rm -f /run/sermon/helper.sock
}
