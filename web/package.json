{
	"name": "sermon-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && pnpm run i18n || echo ''",
		"check": "pnpm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:size": "node scripts/bundle-size.js build 600",
		"lint": "prettier --check . && eslint . && pnpm run lint:help",
		"lint:help": "node scripts/help.js lint ../docs/help src",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@bufbuild/protoc-gen-es": "2.17.0",
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "3.2.2",
		"@inlang/plugin-m-function-matcher": "2.4.3",
		"@inlang/plugin-message-format": "4.6.0",
		"@internationalized/date": "3.12.4",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@vitest/browser-playwright": "5.1.0",
		"bits-ui": "2.21.0",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.17.0",
		"@connectrpc/connect": "2.3.0",
		"@connectrpc/connect-web": "2.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@lucide/svelte": "1.73.0",
		"clsx": "2.1.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"uplot": "1.6.32",
		"uqr": "0.1.3"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=26",
		"pnpm": ">=12"
	}
}
